{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AllowedOrigins": [
    "http://localhost:3000",
    "http://localhost:5173",
    "https://hisabdo.com",
    "https://www.hisabdo.com",
    "https://hisabdo-web.vercel.app"
  ],
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "HisabDoAPI",
    "Audience": "HisabDoApp",
    "ExpiryMinutes": 1440
  },
  "Upload": {
    "MaxSizeBytes": 10485760,
    "AllowedExtensions": [".jpg", ".jpeg", ".png", ".gif", ".pdf"],
    "Directory": "wwwroot/uploads"
  },
  "RateLimiting": {
    "GlobalPermitLimit": 100,
    "GlobalWindowMinutes": 1,
    "AuthPermitLimit": 10,
    "AuthWindowMinutes": 1
  },
  "Pagination": {
    "DefaultPageSize": 50,
    "MaxPageSize": 100
  }
}
