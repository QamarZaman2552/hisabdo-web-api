# HisabDo Environment Variables (Production)
# Copy to .env and fill in real values

# Database
ConnectionStrings__DefaultConnection=Server=YOUR_SERVER;Database=HisabDoDB;User Id=YOUR_USER;Password=YOUR_PASSWORD;

# JWT (minimum 32 characters)
Jwt__Secret=YOUR_SECRET_KEY_HERE_MIN_32_CHARS

# Password Policy (optional overrides)
PasswordPolicy__MinLength=8
PasswordPolicy__MaxLength=64
